# Token otorgado por @BotFather. Déjelo vacío para arrancar sin bot (solo API).
TELEGRAM_BOT_TOKEN=

# Credenciales de la base.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Caducidad de los códigos de un solo uso
WEB_CODE_EXPIRE_MINUTES=5
INVITATION_EXPIRE_MINUTES=15

# Servidor
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Orígenes permitidos para CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# URL pública del panel, usada por el bot para mostrar enlaces.
FRONTEND_URL=http://localhost:3000

# Política de retención: días que se conservan las ubicaciones
LOCATION_RETENTION_DAYS=30

LOG_LEVEL=INFO

# Vacío (recomendado en Docker): el frontend usa la misma origen y Nginx
# proxea `/api` hacia el servicio `backend`. Para desarrollo con `npm run dev`
VITE_API_URL=
FRONTEND_PORT=3000
